<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.DesktopCardsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    xmlns:loc="using:Pane.Localization" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="CardFrame" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource PaneFillControlBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource PaneStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource PaneIconButton}">
            <Setter Property="Width" Value="{StaticResource PaneControlMd}"/>
            <Setter Property="Height" Value="{StaticResource PaneControlMd}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="Header" Padding="18,0,10,0" Background="Transparent" ColumnSpacing="10"
              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PaneStrokeBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <c:PaneIcon Glyph="pin" Width="16" Height="16" Foreground="{ThemeResource PaneText2Brush}"/>
                <TextBlock x:Name="HeaderTitle" Text="{x:Bind loc:Strings.DesktopCards_Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}"
                           Foreground="{ThemeResource PaneText1Brush}"/>
            </StackPanel>
            <StackPanel x:Name="ViewTools" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="VisibilityButton" Style="{StaticResource CardAction}" Click="ToggleVisibilityClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.DesktopCards_Hide}" ToolTipService.ToolTip="{x:Bind loc:Strings.DesktopCards_Hide}">
                    <c:PaneIcon x:Name="VisibilityIcon" Glyph="eye-off" Width="16" Height="16"/>
                </Button>
                <Button x:Name="ArrangeButton" Style="{StaticResource CardAction}" Click="EditArrangementClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.DesktopCards_Arrange}" ToolTipService.ToolTip="{x:Bind loc:Strings.DesktopCards_Arrange}">
                    <c:PaneIcon Glyph="sliders" Width="16" Height="16"/>
                </Button>
                <Button x:Name="TrafficButton" Style="{StaticResource CardAction}" Click="TrafficClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.Module_Traffic_Name}" ToolTipService.ToolTip="{x:Bind loc:Strings.Module_Traffic_Name}">
                    <c:PaneIcon Glyph="globe" Width="16" Height="16"/>
                </Button>
                <Button x:Name="NotesButton" Style="{StaticResource CardAction}" Click="NotesClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.Module_Notes_Name}" ToolTipService.ToolTip="{x:Bind loc:Strings.Module_Notes_Name}">
                    <c:PaneIcon Glyph="pencil" Width="16" Height="16"/>
                </Button>
                <Button x:Name="ScreenshotsButton" Style="{StaticResource CardAction}" Click="ScreenshotsClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.Module_Screenshots_Name}" ToolTipService.ToolTip="{x:Bind loc:Strings.Module_Screenshots_Name}">
                    <c:PaneIcon Glyph="scissors" Width="16" Height="16"/>
                </Button>
            </StackPanel>
            <StackPanel x:Name="ArrangeTools" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="CancelArrangementButton" Style="{StaticResource PaneTextButton}" Click="CancelArrangementClicked" Content="{x:Bind loc:Strings.Common_Cancel}"/>
                <Button x:Name="SaveArrangementButton" Style="{StaticResource PanePrimaryButton}" Click="SaveArrangementClicked" Content="{x:Bind loc:Strings.Common_Save}"/>
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CardAction}" Click="CloseClicked"
                    AutomationProperties.Name="{x:Bind loc:Strings.Common_CloseWindowHint}" ToolTipService.ToolTip="{x:Bind loc:Strings.Common_CloseWindowHint}">
                <c:PaneIcon Glyph="close" Width="16" Height="16"/>
            </Button>
        </Grid>
        <TextBlock x:Name="ArrangementError" Grid.Row="1" Margin="16,8,16,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"
                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" TextWrapping="Wrap" Foreground="{ThemeResource PaneText2Brush}"/>
        <ScrollViewer Grid.Row="2" Padding="16,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <c:WrapPanel x:Name="Tiles" HorizontalSpacing="12" VerticalSpacing="12"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyState" Grid.Row="2" Margin="16" VerticalAlignment="Top" IsHitTestVisible="False"
                   Text="{x:Bind loc:Strings.DesktopCards_Empty}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
    </Grid>
</UserControl>
