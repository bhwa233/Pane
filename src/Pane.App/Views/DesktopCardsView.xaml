<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.DesktopCardsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    xmlns:loc="using:Pane.Localization"
    KeyDown="OnKeyDown">
    <Grid>
        <Canvas x:Name="Tiles" Background="#78000000" Tapped="CanvasTapped" SizeChanged="CanvasSizeChanged"/>
        <Border x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,18,12,0"
                Padding="10,5" CornerRadius="8" BorderThickness="1" BorderBrush="#FF484B50"
                Background="#FF202226" RequestedTheme="Dark">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Button x:Name="PaneButton" Style="{StaticResource PaneIconButton}" IsTabStop="True" Click="ToggleCardsClicked"
                        Margin="0,0,5,0">
                    <Image x:Name="PaneLogo" Width="22" Height="22"/>
                </Button>
                <StackPanel x:Name="PanelTools" Orientation="Horizontal" Spacing="4"/>
                <Button Style="{StaticResource PaneTextButton}" IsTabStop="True" AutomationProperties.Name="{x:Bind loc:Strings.CardDesktop_Add}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <c:PaneIcon Glyph="plus" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind loc:Strings.CardDesktop_Add}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout><MenuFlyout Opening="AddOpening"/></Button.Flyout>
                </Button>
                <TextBlock x:Name="Clock" MinWidth="50" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Style="{StaticResource PaneIconButton}" IsTabStop="True" Click="SettingsClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.Common_Settings}"
                        ToolTipService.ToolTip="{x:Bind loc:Strings.Common_Settings}">
                    <c:PaneIcon Glyph="gear" Width="16" Height="16"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource PaneIconButton}" IsTabStop="True" Click="CloseClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.Common_CloseEscapeHint}"
                        ToolTipService.ToolTip="{x:Bind loc:Strings.Common_CloseEscapeHint}">
                    <c:PaneIcon Glyph="close" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
