<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.DesktopNoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    xmlns:loc="using:Pane.Localization">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="Header" Height="42" Visibility="Collapsed" Background="Transparent" Padding="0,0,6,0" ColumnSpacing="4"
              BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Border x:Name="TitleArea" Width="{StaticResource PaneSpace6}" HorizontalAlignment="Left" Background="Transparent"/>
                <TextBox x:Name="PadTitle" Margin="24,0,0,0" Padding="0,7" VerticalAlignment="Center" VerticalContentAlignment="Center"
                         FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" FontWeight="SemiBold"
                         MaxLength="180" PlaceholderText="{x:Bind loc:Strings.Notes_Title}"
                         AutomationProperties.Name="{x:Bind loc:Strings.Notes_Title}" TextChanged="PadChanged"/>
            </Grid>
            <Button Grid.Column="1" Width="28" Height="28" Style="{StaticResource PaneIconButton}" Click="CollapseClicked"
                    AutomationProperties.Name="{x:Bind loc:Strings.Common_Done}" ToolTipService.ToolTip="{x:Bind loc:Strings.Common_Done}">
                <c:PaneIcon Glyph="check" Width="13" Height="13"/>
            </Button>
            <Button x:Name="TopmostButton" Grid.Column="2" Width="28" Height="28" Style="{StaticResource PaneIconButton}" Click="TopmostClicked">
                <c:PaneIcon x:Name="TopmostIcon" Glyph="pin" Width="13" Height="13"/>
            </Button>
            <Button x:Name="FoldButton" Grid.Column="3" Width="28" Height="28" Style="{StaticResource PaneIconButton}" Click="FoldClicked"
                    AutomationProperties.Name="{x:Bind loc:Strings.Notes_FoldToCapsule}" ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FoldToCapsule}">
                <StackPanel Orientation="Horizontal">
                    <c:PaneIcon Glyph="R" Width="11" Height="11"/>
                    <c:PaneIcon Glyph="L" Width="11" Height="11"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Width="28" Height="28" Style="{StaticResource PaneIconButton}" Click="UnpinClicked"
                    AutomationProperties.Name="{x:Bind loc:Strings.Notes_UnpinDesktop}" ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_UnpinDesktop}">
                <Grid Width="15" Height="15">
                    <c:PaneIcon Glyph="monitor" Width="15" Height="15"/>
                    <FontIcon Glyph="&#xE738;" FontSize="7" VerticalAlignment="Top" Margin="0,3,0,0"/>
                </Grid>
            </Button>
        </Grid>

        <!-- 贴纸面（tile）：只读正文 -->
        <Grid x:Name="TilePane" Grid.Row="1" Background="Transparent">
            <ScrollViewer Padding="12,8" Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontFamily="{StaticResource PaneFontUi}"
                           FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText1Brush}"/>
            </ScrollViewer>
        </Grid>

        <!-- 编辑面（pad）：正文 + 状态行 -->
        <Grid x:Name="PadPane" Grid.Row="1" Padding="10,8,10,8" RowSpacing="6" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="PadBody" AcceptsReturn="True" TextWrapping="Wrap"
                     PlaceholderText="{x:Bind loc:Strings.Notes_Body}" AutomationProperties.Name="{x:Bind loc:Strings.Notes_Body}"
                     FontFamily="{StaticResource PaneFontUi}" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="PadChanged"/>
            <TextBlock x:Name="PadStatus" Grid.Row="1" Visibility="Collapsed" MaxLines="1" TextTrimming="CharacterEllipsis"
                       FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"
                       AutomationProperties.LiveSetting="Polite"/>
        </Grid>

    </Grid>
</UserControl>
