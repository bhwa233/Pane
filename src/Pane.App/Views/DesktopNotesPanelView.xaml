<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.DesktopNotesPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pane.Localization" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Padding="8,8,8,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PanelHint" Text="{x:Bind loc:Strings.Notes_DesktopNotesPanel}" Margin="8,0,8,0"
                   FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
        <ListView x:Name="NoteList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="False"/>
        <TextBlock x:Name="EmptyList" Grid.Row="1" Margin="12" Text="{x:Bind loc:Strings.Notes_Empty}" IsHitTestVisible="False"
                   FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
    </Grid>
</UserControl>
