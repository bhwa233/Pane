<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.DesktopScreenshotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pane.Localization">
    <UserControl.ContextFlyout>
        <MenuFlyout x:Name="Actions">
            <MenuFlyoutItem x:Name="EditItem" Text="{x:Bind loc:Strings.Screenshots_Edit}" Click="EditClicked"/>
            <MenuFlyoutItem Text="{x:Bind loc:Strings.Screenshots_OpenHistory}" Click="OpenClicked"/>
            <MenuFlyoutItem Text="{x:Bind UnpinLabel}" Click="UnpinClicked"/>
            <ToggleMenuFlyoutItem x:Name="TopmostItem" Text="{x:Bind loc:Strings.Notes_Topmost}" Click="TopmostClicked"/>
        </MenuFlyout>
    </UserControl.ContextFlyout>
    <Grid Background="Transparent">
        <Image x:Name="Preview" Stretch="Uniform" ImageFailed="ImageFailed"
               AutomationProperties.Name="{x:Bind loc:Strings.Screenshots_Preview}"/>
        <TextBlock x:Name="ImageError" Margin="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextWrapping="Wrap" Visibility="Collapsed" Text="{x:Bind loc:Strings.Screenshots_LoadFailed}"
                   FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
    </Grid>
</UserControl>
