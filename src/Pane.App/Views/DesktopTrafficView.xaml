<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.DesktopTrafficView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pane.Localization">
    <Grid x:Name="Surface" Background="Transparent" IsTabStop="True"
          PointerEntered="HudEntered" PointerExited="HudExited" Tapped="OpenTapped" KeyDown="HudKeyDown"
          AutomationProperties.Name="{x:Bind loc:Strings.Traffic_DesktopCard}">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="Actions" Opening="ActionsOpening">
                <ToggleMenuFlyoutItem x:Name="TopmostItem" Text="{x:Bind loc:Strings.Notes_Topmost}" Click="OptionsClicked"/>
                <ToggleMenuFlyoutItem x:Name="EdgeItem" Text="{x:Bind loc:Strings.Traffic_EdgeHide}" Click="OptionsClicked"/>
                <ToggleMenuFlyoutItem x:Name="FullscreenItem" Text="{x:Bind loc:Strings.Traffic_FullscreenHide}" Click="OptionsClicked"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{x:Bind loc:Strings.Traffic_OpenPanel}" Click="OpenClicked"/>
                <MenuFlyoutItem Text="{x:Bind loc:Strings.Traffic_CloseHud}" Click="UnpinClicked"/>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Border x:Name="RateCard" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource PaneStrokeBrush}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid Margin="4,2" ColumnSpacing="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="&#x2191;" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneWarningBrush}"
                       AutomationProperties.Name="{x:Bind loc:Strings.Traffic_Upload}"/>
            <TextBlock x:Name="Upload" Grid.Column="1" Text="&#x2014;" FontSize="{StaticResource PaneTextMd}"
                       Foreground="{ThemeResource PaneWarningBrush}"/>
            <TextBlock Grid.Row="1" Text="&#x2193;" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneSuccessBrush}"
                       AutomationProperties.Name="{x:Bind loc:Strings.Traffic_Download}"/>
            <TextBlock x:Name="Download" Grid.Row="1" Grid.Column="1" Text="&#x2014;" FontSize="{StaticResource PaneTextMd}"
                       Foreground="{ThemeResource PaneSuccessBrush}"/>
            <Grid x:Name="ResourceUsage" Grid.Column="2" Grid.RowSpan="2" Margin="3,0,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="CPU" FontSize="{StaticResource PaneTextMd}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CpuUsage" Grid.Column="1" FontSize="{StaticResource PaneTextMd}" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="GPU" FontSize="{StaticResource PaneTextMd}" VerticalAlignment="Center"/>
                <TextBlock x:Name="GpuUsage" Grid.Row="1" Grid.Column="1" FontSize="{StaticResource PaneTextMd}" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{x:Bind loc:Strings.Traffic_MemoryUsage}" FontSize="{StaticResource PaneTextMd}" VerticalAlignment="Center"/>
                <TextBlock x:Name="MemoryUsage" Grid.Column="4" FontSize="{StaticResource PaneTextMd}" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind loc:Strings.Traffic_DiskUsage}" FontSize="{StaticResource PaneTextMd}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DiskUsage" Grid.Row="1" Grid.Column="4" FontSize="{StaticResource PaneTextMd}" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        </Border>
        <Border x:Name="EdgeTab" Background="{ThemeResource PaneSuccessBrush}" Visibility="Collapsed"/>
        <Popup x:Name="RankingPopup" ShouldConstrainToRootBounds="False">
            <Border x:Name="Ranking" Width="260" Padding="10,8" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"
                    PointerEntered="RankingEntered" PointerExited="RankingExited">
                <StackPanel Spacing="4">
                    <StackPanel x:Name="UploadRank" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="UploadHeading" Text="{x:Bind loc:Strings.Traffic_UploadRanking}" Foreground="{ThemeResource PaneWarningBrush}"/>
                        <StackPanel x:Name="UploadRows" Spacing="4"/>
                    </StackPanel>
                    <StackPanel x:Name="DownloadRank" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="DownloadHeading" Text="{x:Bind loc:Strings.Traffic_DownloadRanking}" Foreground="{ThemeResource PaneSuccessBrush}"/>
                        <StackPanel x:Name="DownloadRows" Spacing="4"/>
                    </StackPanel>
                    <TextBlock x:Name="RankStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
