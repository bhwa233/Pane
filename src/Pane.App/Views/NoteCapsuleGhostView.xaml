<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.NoteCapsuleGhostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- 全局拖动胶囊（notes-mvp §7）：拖动期间跟随系统光标的独立薄窗，
         不依赖 XAML 岛捕获，跨屏拖动不丢。半透明强调它的临时性。 -->
    <Border x:Name="Pill" Height="32" MinWidth="120" MaxWidth="240" CornerRadius="14" Opacity="0.85"
            Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneAccentBrush}"
            BorderThickness="1.4" Padding="12,0,12,0" VerticalAlignment="Top">
        <TextBlock x:Name="Title" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"
                   FontFamily="{StaticResource PaneFontUi}" FontSize="12" Foreground="{ThemeResource PaneText1Brush}"/>
    </Border>
</UserControl>
