<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.NoteCapsuleGhostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pane.Views.Controls"
    IsTabStop="False">
    <!-- 全局拖动胶囊（notes-mvp §7）：拖动期间跟随系统光标的独立薄窗，
         不依赖 XAML 岛捕获，跨屏拖动不丢。半透明强调它的临时性。 -->
    <Border x:Name="Pill" Height="32" Opacity="0.9"
            BorderBrush="{ThemeResource PaneAccentBrush}" BorderThickness="1"
            Padding="8,0,8,0" VerticalAlignment="Top">
        <Border.Background><SolidColorBrush Color="{ThemeResource PaneTintColor}"/></Border.Background>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <local:PaneIcon x:Name="Mark" Glyph="note" Width="14" Height="14" VerticalAlignment="Center"
                            Foreground="{ThemeResource PaneAccentBrush}"/>
            <TextBlock x:Name="Title" MaxWidth="116" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="12" Foreground="{ThemeResource PaneText1Brush}"/>
        </StackPanel>
    </Border>
</UserControl>
