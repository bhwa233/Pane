<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.NoteCapsulePreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid Padding="12,10,12,10" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PreviewTitle" MaxLines="1" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                   FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText1Brush}"/>
        <ScrollViewer x:Name="PreviewScroller" Grid.Row="1" IsTabStop="False"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="PreviewBody" TextWrapping="Wrap" IsTextSelectionEnabled="False"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}"
                       Foreground="{ThemeResource PaneText2Brush}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
