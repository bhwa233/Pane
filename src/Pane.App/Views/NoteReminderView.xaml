<UserControl
    x:Class="Pane.Views.NoteReminderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pane.Localization"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">
    <StackPanel Padding="16,14" Spacing="8">
        <Grid x:Name="Header">
            <c:MoveSurface Margin="-16,-14,-16,0"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:PaneIcon Glyph="timer" Width="16" Height="16" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
                <TextBlock Text="{x:Bind loc:Strings.Notes_Reminder}" VerticalAlignment="Center" FontSize="{StaticResource PaneTextSm}"
                           Foreground="{ThemeResource PaneText2Brush}"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="NoteTitle" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource PaneText1Brush}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Style="{StaticResource PaneTextButton}" Content="{x:Bind loc:Strings.Common_Close}" Click="CloseClicked"/>
            <Button Style="{StaticResource PanePrimaryButton}" Content="{x:Bind loc:Strings.Common_Open}" Click="OpenClicked"/>
        </StackPanel>
    </StackPanel>
</UserControl>
