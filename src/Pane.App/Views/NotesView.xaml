<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.NotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    xmlns:loc="using:Pane.Localization">
    <Grid x:Name="NotesRoot">
        <FlyoutBase.AttachedFlyout>
            <!-- 分类改名 / 移动到新分类的共用输入（照 CustomReminderFlyout 的样式） -->
            <Flyout x:Name="CategoryPromptFlyout" Placement="Right" Closed="CategoryPromptClosed">
                <StackPanel Width="224" Spacing="8">
                    <TextBlock x:Name="CategoryPromptTitle" Foreground="{ThemeResource PaneText1Brush}"/>
                    <TextBox x:Name="CategoryPromptInput" MaxLength="64" Header="{x:Bind loc:Strings.Notes_CategoryNamePlaceholder}" KeyDown="CategoryPromptKeyDown"/>
                    <TextBlock x:Name="CategoryPromptStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PaneTextButton}" Content="{x:Bind loc:Strings.Common_Cancel}" Click="CancelCategoryPrompt"/>
                        <Button Style="{StaticResource PanePrimaryButton}" Content="{x:Bind loc:Strings.Common_Save}" Click="SaveCategoryPrompt"/>
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Padding="18,0,10,0" Background="Transparent"
              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PaneStrokeBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <c:PaneIcon Glyph="pencil" Width="16" Height="16" Foreground="{ThemeResource PaneText2Brush}"/>
                <TextBlock Text="{x:Bind loc:Strings.Module_Notes_Name}" VerticalAlignment="Center"
                           FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}"
                           Foreground="{ThemeResource PaneText1Brush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="PreviewButton" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}"
                        Click="PreviewClicked" IsEnabled="False">
                    <c:PaneIcon x:Name="PreviewIcon" Glyph="eye" Width="16" Height="16"/>
                </Button>
                <Button x:Name="FileButton" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}"
                        IsEnabled="False" AutomationProperties.Name="{x:Bind loc:Strings.Notes_FileActions}" ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FileActions}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind loc:Strings.Notes_ImportFile}" Click="ImportFileClicked"/>
                            <MenuFlyoutItem x:Name="ExportFileItem" Text="{x:Bind loc:Strings.Notes_ExportFile}" Click="ExportFileClicked"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <c:PaneIcon Glyph="folder" Width="16" Height="16"/>
                </Button>
                <Button x:Name="RecycleBinButton" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}"
                        Click="RecycleBinClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_RecycleBin}"
                        ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_RecycleBin}">
                    <c:PaneIcon Glyph="trash" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}"
                        Click="CloseClicked" AutomationProperties.Name="{x:Bind loc:Strings.Common_CloseWindowHint}"
                        ToolTipService.ToolTip="{x:Bind loc:Strings.Common_CloseWindowHint}">
                    <c:PaneIcon Glyph="close" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid x:Name="NotesWorkspace" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Padding="10,10,10,12" RowSpacing="8" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource PaneStrokeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox x:Name="SearchBox" Width="112" PlaceholderText="{x:Bind loc:Strings.Common_Search}"
                             AutomationProperties.Name="{x:Bind loc:Strings.Common_Search}" TextChanged="SearchChanged"/>
                    <Button x:Name="NewButton" Style="{StaticResource PaneIconButton}" Width="32" Height="32" Click="NewClicked"
                            ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_New}" AutomationProperties.Name="{x:Bind loc:Strings.Notes_New}">
                        <c:PaneIcon Glyph="plus" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
                <ComboBox x:Name="CategoryFilter" Grid.Row="1" HorizontalAlignment="Stretch" MinWidth="0"
                          AutomationProperties.Name="{x:Bind loc:Strings.Notes_CategoryFilter}" SelectionChanged="CategoryFilterChanged"/>
                <ListView x:Name="NoteList" Grid.Row="2" SelectionChanged="SelectionChanged"
                          AutomationProperties.Name="{x:Bind loc:Strings.Module_Notes_Name}"/>
                <TextBlock x:Name="EmptyList" Grid.Row="2" Margin="8" IsHitTestVisible="False" TextWrapping="Wrap"
                           FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            </Grid>
            <Grid x:Name="EditorPane" Grid.Column="1" Padding="14,12,14,12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" PlaceholderText="{x:Bind loc:Strings.Notes_Title}"
                             AutomationProperties.Name="{x:Bind loc:Strings.Notes_Title}" TextChanged="EditorChanged"/>
                    <TextBox x:Name="CategoryBox" Grid.Column="1" MaxLength="64" PlaceholderText="{x:Bind loc:Strings.Notes_Category}"
                             AutomationProperties.Name="{x:Bind loc:Strings.Notes_Category}" TextChanged="EditorChanged"/>
                    <Button x:Name="NoteImageButton" Grid.Column="2" Style="{StaticResource PaneIconButton}" IsTabStop="True"
                            AutomationProperties.Name="{x:Bind loc:Strings.Notes_Images}" ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_Images}">
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind loc:Strings.Notes_ImportImage}" Click="ImportImageClicked"/>
                            <MenuFlyoutItem Text="{x:Bind loc:Strings.Notes_PasteImage}" Click="PasteImageClicked"/>
                        </MenuFlyout></Button.Flyout>
                        <c:PaneIcon Glyph="image" Width="16" Height="16"/>
                    </Button>
                </Grid>
                <!-- 编辑工具行（galaxy 对齐）：Markdown 模式才显示格式按钮；编辑 / 分栏 / 预览三态；撤销重做 -->
                <StackPanel x:Name="EditorToolbar" Grid.Row="1" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <Button x:Name="MarkdownModeButton" Style="{StaticResource PaneTextButton}" MinHeight="28" Padding="10,2"
                            Click="MarkdownModeClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_MarkdownMode}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2" x:Name="FormatButtons">
                        <Button Style="{StaticResource PaneIconButton}" Width="30" Height="28" Content="B" FontWeight="SemiBold"
                                Click="FormatBoldClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_FormatBold}"
                                ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FormatBold}"/>
                        <Button Style="{StaticResource PaneIconButton}" Width="30" Height="28" Content="I" FontStyle="Italic"
                                Click="FormatItalicClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_FormatItalic}"
                                ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FormatItalic}"/>
                        <Button Style="{StaticResource PaneIconButton}" Width="30" Height="28" Content="H"
                                Click="FormatHeadingClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_FormatHeading}"
                                ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FormatHeading}"/>
                        <Button Style="{StaticResource PaneIconButton}" Width="30" Height="28" Content="—"
                                Click="FormatHrClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_FormatHr}"
                                ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FormatHr}"/>
                        <Button Style="{StaticResource PaneIconButton}" Width="34" Height="28" Content="• 列表"
                                FontSize="{StaticResource PaneTextXs}" Click="FormatListClicked"
                                AutomationProperties.Name="{x:Bind loc:Strings.Notes_FormatList}" ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FormatList}"/>
                        <Button Style="{StaticResource PaneIconButton}" Width="34" Height="28" Content="1. 列表"
                                FontSize="{StaticResource PaneTextXs}" Click="FormatOrderedListClicked"
                                AutomationProperties.Name="{x:Bind loc:Strings.Notes_FormatOrderedList}" ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FormatOrderedList}"/>
                        <Button Style="{StaticResource PaneIconButton}" Width="34" Height="28" Content="&lt;/&gt;"
                                FontFamily="{StaticResource PaneFontMono}" FontSize="{StaticResource PaneTextXs}" Click="FormatCodeClicked"
                                AutomationProperties.Name="{x:Bind loc:Strings.Notes_FormatCode}" ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FormatCode}"/>
                        <Button Style="{StaticResource PaneIconButton}" Width="30" Height="28" Content="❞"
                                Click="FormatQuoteClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_FormatQuote}"
                                ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_FormatQuote}"/>
                    </StackPanel>
                    <Border Width="1" Height="20" Background="{ThemeResource PaneStrokeBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <Button x:Name="UndoButton" Style="{StaticResource PaneIconButton}" Width="30" Height="28"
                            Click="UndoClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_Undo}"
                            ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_Undo}">
                        <c:PaneIcon Glyph="undo" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource PaneIconButton}" Width="30" Height="28"
                            Click="RedoClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_Redo}"
                            ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_Redo}">
                        <c:PaneIcon Glyph="undo" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                            <c:PaneIcon.RenderTransform>
                                <ScaleTransform ScaleX="-1"/>
                            </c:PaneIcon.RenderTransform>
                        </c:PaneIcon>
                    </Button>
                    <Border Width="1" Height="20" Background="{ThemeResource PaneStrokeBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <Button x:Name="EditModeButton" Style="{StaticResource PaneTextButton}" MinHeight="28" Padding="10,2"
                            Click="EditViewClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_ViewModeEdit}"/>
                    <Button x:Name="SplitModeButton" Style="{StaticResource PaneTextButton}" MinHeight="28" Padding="10,2"
                            Click="SplitViewClicked" AutomationProperties.Name="{x:Bind loc:Strings.Notes_ViewModeSplit}"/>
                    <TextBlock x:Name="CharCount" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BodyColumn" Width="*"/>
                        <ColumnDefinition x:Name="SplitDividerColumn" Width="0"/>
                        <ColumnDefinition x:Name="SplitColumn" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" Paste="BodyPaste"
                         PlaceholderText="{x:Bind loc:Strings.Notes_Body}" AutomationProperties.Name="{x:Bind loc:Strings.Notes_Body}"
                         FontFamily="{StaticResource PaneFontUi}" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="EditorChanged"/>
                    <ScrollViewer x:Name="MarkdownPreview" Visibility="Collapsed" IsTabStop="True" Padding="4,2,8,4"
                                  AutomationProperties.Name="{x:Bind loc:Strings.Notes_Preview}">
                        <StackPanel x:Name="PreviewBlocks" Spacing="8"/>
                    </ScrollViewer>
                        <ScrollViewer x:Name="NoteImageScroller" Grid.Row="1" Visibility="Collapsed" MaxHeight="96"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <StackPanel x:Name="NoteImages" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0"/>
                        </ScrollViewer>
                    </Grid>
                    <!-- 分栏拖条：Pointer 拖动调整左右比例 -->
                    <Grid x:Name="SplitDivider" Grid.Column="1" Width="8" Background="Transparent" Visibility="Collapsed"
                          PointerPressed="DividerPressed" PointerMoved="DividerMoved" PointerReleased="DividerReleased"
                          AutomationProperties.Name="{x:Bind loc:Strings.Notes_ViewModeSplit}">
                        <Border Width="2" HorizontalAlignment="Center" Background="{ThemeResource PaneStrokeBrush}"/>
                    </Grid>
                    <ScrollViewer x:Name="SplitPreview" Grid.Column="2" Visibility="Collapsed" IsTabStop="False" Padding="4,2,8,4"
                                  AutomationProperties.Name="{x:Bind loc:Strings.Notes_ViewModeSplit}">
                        <StackPanel x:Name="SplitBlocks" Spacing="8"/>
                    </ScrollViewer>
                </Grid>
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                    <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource PaneIconButton}" Width="32" Height="32" Click="PinClicked">
                        <c:PaneIcon x:Name="PinIcon" Glyph="pin" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="HistoryButton" Grid.Column="2" Style="{StaticResource PaneIconButton}" Width="32" Height="32"
                            AutomationProperties.Name="{x:Bind loc:Strings.Notes_History}" ToolTipService.ToolTip="{x:Bind loc:Strings.Notes_History}"
                            Click="HistoryClicked" IsEnabled="False">
                        <c:PaneIcon Glyph="history" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="ReminderButton" Grid.Column="3" Style="{StaticResource PaneIconButton}" Width="32" Height="32" IsEnabled="False"
                            AutomationProperties.Name="{x:Bind loc:Strings.Notes_Reminder}">
                        <Button.Flyout>
                            <MenuFlyout Opening="ReminderMenuOpening"/>
                        </Button.Flyout>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="CustomReminderFlyout" Placement="Top" Closed="CustomReminderClosed">
                                <StackPanel Width="224" Spacing="8">
                                    <TextBlock x:Name="CustomReminderScope" Visibility="Collapsed" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PaneText1Brush}"/>
                                    <TextBox x:Name="CustomReminderMinutes" InputScope="Number" Header="{x:Bind loc:Strings.Notes_ReminderMinutes}" KeyDown="CustomReminderKeyDown"/>
                                    <TextBlock x:Name="CustomReminderStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource PaneTextButton}" Content="{x:Bind loc:Strings.Common_Cancel}" Click="CancelCustomReminder"/>
                                        <Button Style="{StaticResource PanePrimaryButton}" Content="{x:Bind loc:Strings.Common_Save}" Click="SaveCustomReminder"/>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <c:PaneIcon Glyph="timer" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="DeleteButton" Grid.Column="4" Style="{StaticResource PaneIconButton}" Width="32" Height="32"
                            AutomationProperties.Name="{x:Bind loc:Strings.Common_Delete}" ToolTipService.ToolTip="{x:Bind loc:Strings.Common_Delete}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{x:Bind loc:Strings.Notes_Delete}" Click="DeleteClicked"/>
                            </MenuFlyout>
                        </Button.Flyout>
                        <c:PaneIcon Glyph="trash" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="SaveButton" Grid.Column="5" Style="{StaticResource PanePrimaryButton}" Click="SaveClicked"
                            Content="{x:Bind loc:Strings.Common_Save}"/>
                </Grid>
            </Grid>
            <Grid x:Name="HistoryPane" Grid.Column="1" Padding="14,12,14,12" RowSpacing="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HistoryBackButton" Click="HistoryBackClicked" Content="{x:Bind loc:Strings.Common_Back}"/>
                    <ComboBox x:Name="HistoryVersions" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="HistorySelectionChanged"
                              PlaceholderText="{x:Bind loc:Strings.Notes_History}"
                              AutomationProperties.Name="{x:Bind loc:Strings.Notes_History}"/>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock x:Name="HistoryTitle" TextTrimming="CharacterEllipsis" MaxLines="1"
                               FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText1Brush}"/>
                    <TextBlock x:Name="HistoryCategory" TextTrimming="CharacterEllipsis" MaxLines="1"
                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="HistoryBody" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         AutomationProperties.Name="{x:Bind loc:Strings.Notes_Body}"
                         FontFamily="{StaticResource PaneFontUi}" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <ScrollViewer x:Name="HistoryImageScroller" Grid.Row="1" Visibility="Collapsed" MaxHeight="96"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="HistoryImages" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0"/>
                    </ScrollViewer>
                </Grid>
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HistoryStatus" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                    <Button x:Name="RestoreVersionButton" Grid.Column="1" Style="{StaticResource PanePrimaryButton}" IsEnabled="False"
                            Content="{x:Bind loc:Strings.Common_Restore}" Click="RestoreVersionClicked"/>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="RecyclePane" Grid.Row="1" Padding="14,12,14,12" RowSpacing="10" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                <Button x:Name="RecycleBackButton" Click="RecycleBackClicked" Content="{x:Bind loc:Strings.Common_Back}"/>
                <TextBlock Text="{x:Bind loc:Strings.Notes_RecycleBin}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"
                           FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText1Brush}"/>
            </StackPanel>
            <ListView x:Name="RecycleList" Grid.Row="1" SelectionChanged="RecycleSelectionChanged"
                      AutomationProperties.Name="{x:Bind loc:Strings.Notes_RecycleBin}"/>
            <TextBlock x:Name="RecycleEmpty" Grid.Row="1" Grid.ColumnSpan="2" Margin="8" IsHitTestVisible="False"
                       Text="{x:Bind loc:Strings.Notes_RecycleEmpty}" Foreground="{ThemeResource PaneText2Brush}"/>
            <TextBox x:Name="RecycleBody" Grid.Row="1" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" FontFamily="{StaticResource PaneFontUi}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{x:Bind loc:Strings.Notes_Body}" Visibility="Collapsed"/>
            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RecycleStatus" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PurgeNoteButton" Content="{x:Bind loc:Strings.Notes_RecyclePurge}" IsEnabled="False">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{x:Bind loc:Strings.Notes_RecyclePurgeConfirm}" Click="PurgeNoteClicked"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="RestoreNoteButton" Style="{StaticResource PanePrimaryButton}" IsEnabled="False"
                            Content="{x:Bind loc:Strings.Common_Restore}" Click="RestoreNoteClicked"/>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="MonoProto" FontFamily="{StaticResource PaneFontMono}" Foreground="{ThemeResource PaneText2Brush}"/>
            <TextBlock x:Name="MathProto" FontFamily="{StaticResource PaneFontMath}" Foreground="{ThemeResource PaneAccentBrush}"/>
            <TextBlock x:Name="Text3Proto" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="CodeProto" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
