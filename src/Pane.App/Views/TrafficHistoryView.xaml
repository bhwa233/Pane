<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pane.Views.TrafficHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    xmlns:loc="using:Pane.Localization">
    <UserControl.Resources>
        <Style x:Key="ProcessHistoryAction" TargetType="Button" BasedOn="{StaticResource PaneIconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid Padding="16,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="Range" Width="152" SelectionChanged="RangeChanged"
                          AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryRange}">
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistoryQuarterHour}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistoryHour}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistoryDay}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistoryWeek}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistoryToday}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistoryYesterday}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistoryMonth}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistoryCustom}"/>
                </ComboBox>
                <Button x:Name="RefreshButton" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}"
                        Height="{StaticResource PaneControlMd}" Click="RefreshClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryRefresh}" ToolTipService.ToolTip="{x:Bind loc:Strings.Traffic_HistoryRefresh}">
                    <c:PaneIcon Glyph="refresh" Width="16" Height="16"/>
                </Button>
                <Button x:Name="ClearButton" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}"
                        Height="{StaticResource PaneControlMd}" Click="ArmClearClicked" IsEnabled="False"
                        AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryClear}" ToolTipService.ToolTip="{x:Bind loc:Strings.Traffic_HistoryClear}">
                    <c:PaneIcon Glyph="trash" Width="16" Height="16"/>
                </Button>
                <Border x:Name="HistoryModeHost" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid x:Name="CustomDates" Visibility="Collapsed" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CalendarDatePicker x:Name="StartDate" HorizontalAlignment="Stretch" DateChanged="CustomDatesChanged"
                                    PlaceholderText="{x:Bind loc:Strings.Traffic_HistoryStartDate}" AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryStartDate}"/>
                <CalendarDatePicker x:Name="EndDate" Grid.Column="1" HorizontalAlignment="Stretch" DateChanged="CustomDatesChanged"
                                    PlaceholderText="{x:Bind loc:Strings.Traffic_HistoryEndDate}" AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryEndDate}"/>
                <Button x:Name="QueryDatesButton" Grid.Column="2" Style="{StaticResource PanePrimaryButton}" Click="RefreshClicked"
                        Content="{x:Bind loc:Strings.Traffic_HistoryQueryDates}"/>
              </Grid>
              <Grid x:Name="ApplicationOptions" Visibility="Collapsed" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ApplicationKeyword" TextChanged="ApplicationKeywordChanged" KeyDown="ApplicationKeywordKeyDown"
                         PlaceholderText="{x:Bind loc:Strings.Traffic_HistoryApplicationKeyword}"
                         AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryApplicationKeyword}"/>
                <ComboBox x:Name="ApplicationSort" Grid.Column="1" MinWidth="116" SelectionChanged="ApplicationSortChanged"
                          AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryApplicationSort}">
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistorySortTotal}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_Download}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_Upload}"/>
                    <ComboBoxItem Content="{x:Bind loc:Strings.Traffic_HistorySortName}"/>
                </ComboBox>
                <Button x:Name="ApplyApplicationOptions" Grid.Column="2" Style="{StaticResource PaneIconButton}" Click="RefreshClicked"
                        Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}"
                        AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryApplyOptions}" ToolTipService.ToolTip="{x:Bind loc:Strings.Traffic_HistoryApplyOptions}">
                    <c:PaneIcon Glyph="search" Width="16" Height="16"/>
                </Button>
              </Grid>
              <Grid x:Name="ProcessFilter" Visibility="Collapsed" ColumnSpacing="8" Padding="8,0"
                    BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PaneStrokeBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ProcessFilterLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}" AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="1" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}"
                        Height="{StaticResource PaneControlMd}" Click="ClearProcessFilterClicked"
                        AutomationProperties.Name="{x:Bind loc:Strings.Traffic_HistoryAllProcesses}" ToolTipService.ToolTip="{x:Bind loc:Strings.Traffic_HistoryAllProcesses}">
                    <c:PaneIcon Glyph="close" Width="14" Height="14"/>
                </Button>
              </Grid>
              <Grid x:Name="ConfirmClear" Visibility="Collapsed" ColumnSpacing="10" Padding="8,6"
                    BorderThickness="1" BorderBrush="{ThemeResource PaneStrokeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind loc:Strings.Traffic_HistoryClearWarning}" TextWrapping="Wrap" VerticalAlignment="Center"
                           FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="CancelClear" Grid.Column="1" Click="CancelClearClicked" Content="{x:Bind loc:Strings.Common_Cancel}"/>
                <Button Grid.Column="2" Click="ClearConfirmed" Content="{x:Bind loc:Strings.Traffic_HistoryClearConfirm}"/>
              </Grid>
              <TextBlock x:Name="RecordedTotals" Visibility="Collapsed" TextWrapping="Wrap"
                         FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
              <TextBlock x:Name="BucketNotice" Visibility="Collapsed" TextWrapping="Wrap"
                         Text="{x:Bind loc:Strings.Traffic_HistoryPartialBuckets}"
                         FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
            </StackPanel>
            <Grid x:Name="Columns" Grid.Row="1" Padding="8,0,20,0" ColumnSpacing="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TimeColumn" Width="136"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TimeLabel" Text="{x:Bind loc:Strings.Traffic_HistoryTime}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                <TextBlock x:Name="NameLabel" Grid.Column="1" Text="{x:Bind loc:Strings.Traffic_ProcessName}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind loc:Strings.Traffic_Download}" TextAlignment="Right" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                <TextBlock Grid.Column="3" Text="{x:Bind loc:Strings.Traffic_Upload}" TextAlignment="Right" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
            </Grid>
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="ModeStrong" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText1Brush}"/>
                <TextBlock x:Name="ModeDim" Foreground="{ThemeResource PaneText2Brush}"/>
                <Border x:Name="ModeSurface" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"/>
            </StackPanel>
            <ListView x:Name="Entries" Grid.Row="2" SelectionMode="None" Visibility="Collapsed"
                      ScrollViewer.VerticalScrollBarVisibility="Visible" AutomationProperties.Name="{x:Bind loc:Strings.Traffic_History}"/>
            <TextBlock x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                       FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}" AutomationProperties.LiveSetting="Polite"/>
            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                           FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                <Button x:Name="Next" Grid.Column="1" Click="NextClicked" IsEnabled="False" Content="{x:Bind loc:Strings.Traffic_HistoryNext}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
