<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pane.Views.TrafficView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    xmlns:loc="using:Pane.Localization">
    <UserControl.Resources>
        <Style x:Key="TrafficSortHeader" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="{StaticResource PaneTextXs}"/>
        </Style>
        <Style x:Key="ProcessHistoryButton" TargetType="Button" BasedOn="{StaticResource PaneIconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Padding="12,8" Spacing="6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind loc:Strings.Traffic_InterfaceTotal}" FontFamily="{StaticResource PaneFontUi}"
                               FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ProcessHistoryButton}"
                            AutomationProperties.Name="{x:Bind loc:Strings.Traffic_InterfaceDetails}"
                            ToolTipService.ToolTip="{x:Bind loc:Strings.Traffic_InterfaceDetails}">
                        <c:PaneIcon Glyph="info" Width="14" Height="14"/>
                        <Button.Flyout>
                            <Flyout x:Name="AdapterFlyout" Placement="Bottom" Opening="AdapterFlyoutOpening" Closed="AdapterFlyoutClosed">
                                <StackPanel Width="254" Spacing="8">
                                    <TextBlock Text="{x:Bind loc:Strings.Traffic_InterfaceDetails}" FontSize="{StaticResource PaneTextSm}"
                                               FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
                                    <TextBlock x:Name="AdapterStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                                    <ScrollViewer MaxHeight="224" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="AdapterRows" Spacing="10"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind loc:Strings.Traffic_InterfaceMonitoring}" FontSize="{StaticResource PaneTextXs}"
                               Foreground="{ThemeResource PaneText2Brush}" VerticalAlignment="Center"/>
                    <Border x:Name="InterfaceSwitchHost" VerticalAlignment="Center"/>
                    <Button x:Name="PinButton" Style="{StaticResource PaneIconButton}"
                            Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="PinClicked">
                        <c:PaneIcon x:Name="PinIcon" Glyph="pin" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="16" Padding="0,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PaneStrokeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind loc:Strings.Traffic_Download}" FontSize="{StaticResource PaneTextXs}"
                               Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock x:Name="Download" FontSize="16" FontWeight="SemiBold" Text="—"
                               Foreground="{ThemeResource PaneSuccessBrush}"/>
                    <Canvas x:Name="DownloadPlot" Width="48" Height="18" IsHitTestVisible="False">
                        <Polyline x:Name="DownloadLine" Stroke="{ThemeResource PaneSuccessBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                    </Canvas>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind loc:Strings.Traffic_Upload}" FontSize="{StaticResource PaneTextXs}"
                               Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock x:Name="Upload" FontSize="16" FontWeight="SemiBold" Text="—"
                               Foreground="{ThemeResource PaneWarningBrush}"/>
                    <Canvas x:Name="UploadPlot" Width="48" Height="18" IsHitTestVisible="False">
                        <Polyline x:Name="UploadLine" Stroke="{ThemeResource PaneWarningBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                    </Canvas>
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TrendCaption" Text="{x:Bind loc:Strings.Traffic_TrendWindow}" FontSize="{StaticResource PaneTextXs}"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PaneText2Brush}"/>
                <TextBlock x:Name="Status" Grid.Column="1" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="1" Padding="12,8,12,10" RowSpacing="6"
              BorderThickness="0,1,0,0" BorderBrush="{ThemeResource PaneStrokeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid MinHeight="24" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ProcessTitle" Text="{x:Bind loc:Strings.Traffic_ProcessTitle}" VerticalAlignment="Center"
                           FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText1Brush}" TextWrapping="Wrap"/>
                <Border x:Name="ProcessModeHost" Grid.Column="1" VerticalAlignment="Center"/>
                <Border x:Name="ProcessSwitchHost" Grid.Column="2" VerticalAlignment="Center"/>
                <Border x:Name="TogglePrototype" Visibility="Collapsed" Background="{ThemeResource PaneFillControlBrush}"
                        BorderBrush="{ThemeResource PaneStrokeBrush}"/>
                <Border x:Name="AccentPrototype" Visibility="Collapsed" Background="{ThemeResource PaneAccentBrush}"/>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ProcessStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"
                           FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                <CheckBox x:Name="ProcessActiveOnly" Grid.Column="1" MinWidth="0" IsEnabled="False"
                          Content="{x:Bind loc:Strings.Traffic_RankingActiveOnly}"
                          Checked="ProcessActiveOnlyChanged" Unchecked="ProcessActiveOnlyChanged"/>
                <Button x:Name="ProcessRetry" Grid.Column="2" Style="{StaticResource PaneIconButton}" Visibility="Collapsed"
                        Click="ProcessRetryClicked" AutomationProperties.Name="{x:Bind loc:Strings.Common_Retry}"
                        ToolTipService.ToolTip="{x:Bind loc:Strings.Common_Retry}">
                    <c:PaneIcon Glyph="refresh" Width="16" Height="16"/>
                </Button>
                <Button x:Name="InstallTrafficService" Grid.Column="2" Visibility="Collapsed"
                        Content="{x:Bind loc:Strings.Traffic_InstallService}" Click="InstallTrafficServiceClicked"/>
            </Grid>
            <Grid Grid.Row="2">
                <TextBox x:Name="ProcessFilter" PlaceholderText="{x:Bind loc:Strings.Traffic_RankingFilter}"
                         AutomationProperties.Name="{x:Bind loc:Strings.Traffic_RankingFilter}" TextChanged="ProcessFilterChanged"/>
            </Grid>
            <Grid x:Name="EndProcessConfirmation" Grid.Row="3" Visibility="Collapsed" ColumnSpacing="8" Padding="8,6"
                  BorderThickness="1" BorderBrush="{ThemeResource PaneStrokeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="EndProcessTarget" TextTrimming="CharacterEllipsis" FontSize="{StaticResource PaneTextXs}"
                               Foreground="{ThemeResource PaneText1Brush}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{x:Bind loc:Strings.Traffic_EndProcessWarning}" TextWrapping="Wrap"
                               FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
                <Button x:Name="CancelEndProcess" Grid.Column="1" Click="CancelEndProcessClicked" Content="{x:Bind loc:Strings.Common_Cancel}"/>
                <Button Grid.Column="2" Click="EndProcessClicked" Content="{x:Bind loc:Strings.Traffic_EndProcess}"
                        Foreground="{ThemeResource PaneDangerBrush}"/>
            </Grid>
            <TextBlock x:Name="ProcessNoMatches" Grid.Row="4" Visibility="Collapsed" TextWrapping="Wrap"
                       Text="{x:Bind loc:Strings.Traffic_RankingNoMatch}" AutomationProperties.LiveSetting="Polite"
                       FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
            <Grid x:Name="ProcessTable" Grid.Row="4" Visibility="Collapsed" BorderThickness="1" CornerRadius="8"
                  BorderBrush="{ThemeResource PaneStrokeBrush}" Background="Transparent"
                  PointerEntered="RankingPointerEntered" PointerExited="RankingPointerExited">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="8" Padding="8,2" Background="{ThemeResource PaneFillControlBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SortName" Tag="Name" Style="{StaticResource TrafficSortHeader}" Click="SortHeaderClicked"
                            HorizontalContentAlignment="Left" Foreground="{ThemeResource PaneText2Brush}"/>
                    <Button x:Name="SortDownload" Grid.Column="1" Tag="Download" Style="{StaticResource TrafficSortHeader}" Click="SortHeaderClicked"
                            Foreground="{ThemeResource PaneSuccessBrush}"/>
                    <Button x:Name="SortUpload" Grid.Column="2" Tag="Upload" Style="{StaticResource TrafficSortHeader}" Click="SortHeaderClicked"
                            Foreground="{ThemeResource PaneWarningBrush}"/>
                    <Button x:Name="SortRunDownload" Grid.Column="3" Tag="RunDownload" Style="{StaticResource TrafficSortHeader}" Click="SortHeaderClicked"
                            Foreground="{ThemeResource PaneSuccessBrush}"/>
                    <Button x:Name="SortRunUpload" Grid.Column="4" Tag="RunUpload" Style="{StaticResource TrafficSortHeader}" Click="SortHeaderClicked"
                            Foreground="{ThemeResource PaneWarningBrush}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="ProcessRows"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
