<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pane</AssemblyName>
    <Product>Pane</Product>
    <ApplicationIcon>../Pane.App/Assets/pane.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="payload.zip" />
    <AssemblyMetadata Include="PanePayloadSha256" Value="$(PayloadSha256)" />
  </ItemGroup>
</Project>
